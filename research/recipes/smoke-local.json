{
  "schema_version": 1,
  "name": "smoke-local",
  "description": "Local-only replayable experiment that consumes compare, benchmark, and proof gates without mutating source files.",
  "local_only": true,
  "external_services_allowed": false,
  "commands": [
    {
      "name": "compare-goldens",
      "command": ["./research/scripts/run_compare.sh"]
    },
    {
      "name": "benchmark-gates",
      "command": ["./research/scripts/run_bench.sh"]
    },
    {
      "name": "proof-gates",
      "command": ["./research/scripts/run_proof.sh"]
    }
  ],
  "evaluation": {
    "required_artifact_kinds": ["compare", "benchmark", "proof"],
    "required_benchmark_gates": [
      "primitive_coverage",
      "mnist_real_gpu_path",
      "llm_real_decoder_path"
    ]
  }
}
